# Copy to .env and fill in. Never commit .env.

# Postgres connection for the restricted app role (Supabase: Session pooler string).
# Supabase format: postgresql://shortener_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://shortener_app:change-me@localhost:5432/shortener

# At least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=30

# Comma-separated allowed frontend origins. Never "*".
CORS_ORIGINS=http://localhost:3000

# Public base URL of THIS backend, used to build short links (e.g. https://your-api.onrender.com)
PUBLIC_BASE_URL=http://localhost:8000

# development or production (production turns on HSTS)
ENVIRONMENT=development

# --- Tests only (real Postgres) ---
# TEST_DATABASE_URL connects as the app role; TEST_ADMIN_DATABASE_URL as the owner (to reset tables).
TEST_DATABASE_URL=postgresql://shortener_app:change-me@localhost:5432/shortener_test
TEST_ADMIN_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/shortener_test
